# AgentLedger Windows distribution example
AGENT_GATEWAY_URL=http://127.0.0.1:8080
AGENT_RELEASE_CHANNEL=stable
AGENT_CONFIG_DIR=C:\ProgramData\AgentLedger\config
AGENT_QUEUE_DIR=C:\ProgramData\AgentLedger\queue
