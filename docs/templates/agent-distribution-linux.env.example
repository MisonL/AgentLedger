# AgentLedger Linux distribution example
AGENT_GATEWAY_URL=http://127.0.0.1:8080
AGENT_RELEASE_CHANNEL=stable
AGENT_CONFIG_DIR=/var/lib/agentledger/config
AGENT_QUEUE_DIR=/var/lib/agentledger/queue
# Optional: enable signed update download verification
# AGENT_RELEASE_SIGNING_PUBLIC_KEY_FILE=/etc/agentledger/AGENT_RELEASE_SIGNING_PUBLIC_KEY.pem
